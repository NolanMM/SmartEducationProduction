@{
    ViewData["Title"] = "About Us";
}

<div class="container-fluid bg-primary bg-black text-white text-center py-3">
    <div class="container py-5">
        <h1 class="display-4 fw-bold">About SmartEducation</h1>
        <p class="lead col-lg-8 mx-auto">
            We are a passionate team dedicated to revolutionizing the learning experience through innovative technology and engaging educational content.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row align-items-center">
        <div class="col-lg-6">
            <h2 class="fw-light">Our Mission</h2>
            <p class="text-body-secondary">
                Our mission is to make high-quality education accessible to everyone, everywhere. We aim to empower learners by providing them with the tools and resources they need to succeed in a rapidly changing world. We believe in fostering curiosity, creativity, and a lifelong love of learning.
            </p>
            <p>
                Through our platform, we connect educators, students, and parents to create a collaborative and supportive learning ecosystem.
            </p>
        </div>
        <div class="col-lg-6 text-center">

            <img src="https://placehold.co/500x350/EBF5FF/000000?text=Our+Vision" class="img-fluid rounded-4 shadow" alt="Collaborative learning environment">
        </div>
    </div>
</div>

<div class="bg-body-tertiary">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h2 class="fw-light">Our Core Values</h2>
            <p class="lead text-body-secondary">The principles that guide our work every day.</p>
        </div>
        <div class="row text-center g-4">
            <div class="col-md-4">
                <div class="p-4">
                    <i class="bi bi-lightbulb-fill fs-1 text-primary"></i>
                    <h4 class="fw-normal mt-3">Innovation</h4>
                    <p class="text-body-secondary">We constantly seek new and better ways to deliver educational content and enhance the learning process.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <i class="bi bi-people-fill fs-1 text-primary"></i>
                    <h4 class="fw-normal mt-3">Community</h4>
                    <p class="text-body-secondary">We foster a supportive and inclusive community where learners and educators can thrive together.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-4">
                    <i class="bi bi-shield-check fs-1 text-primary"></i>
                    <h4 class="fw-normal mt-3">Integrity</h4>
                    <p class="text-body-secondary">We are committed to the highest standards of excellence and ethical conduct in everything we do.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-light">Meet the Team</h2>
        <p class="lead text-body-secondary">The passionate individuals behind our success.</p>
    </div>
    <div class="row g-4 justify-content-center">
        <div class="col-lg-3 col-md-6">
            <div class="card text-center border-0 h-100">
                <div class="card-body">

                    <img src="https://placehold.co/150x150/EBF5FF/000000?text=Team" class="img-fluid rounded-circle mb-3" alt="Team Member Jane Doe">
                    <h5 class="card-title mb-0">Quan Nguyen</h5>
                    @* <p class="card-text text-body-secondary">Founder & CEO</p> *@
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card text-center border-0 h-100">
                <div class="card-body">

                    <img src="https://placehold.co/150x150/EBF5FF/000000?text=Team" class="img-fluid rounded-circle mb-3" alt="Team Member John Smith">
                    <h5 class="card-title mb-0">Jason</h5>
                    @* <p class="card-text text-body-secondary">Head of Curriculum</p> *@
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card text-center border-0 h-100">
                <div class="card-body">

                    <img src="https://placehold.co/150x150/EBF5FF/000000?text=Team" class="img-fluid rounded-circle mb-3" alt="Team Member Emily Johnson">
                    <h5 class="card-title mb-0">NolanM</h5>
                    @* <p class="card-text text-body-secondary">Lead Developer</p> *@
                </div>
            </div>
        </div>
    </div>
</div>

<div class="bg-body-tertiary">
    <div class="container text-center py-5">
        <h2 class="fw-light">Join Our Community</h2>
        <p class="lead text-body-secondary col-lg-8 mx-auto">
            Ready to start your learning journey with us? Explore our features or get in touch with our team today.
        </p>
        <a href="#" style="border-color:black" class="btn btn-primary bg-black btn-lg mt-3">Get Started</a>
    </div>
</div>