@model IEnumerable<SmartEducation.Entities.User>

@{
    ViewData["Title"] = "Manage Users";
}

<h1>Manage Users</h1>
<p>
    <a asp-action="CreateUser" class="btn btn-success">Create New User</a>
</p>

<div class="card">
    <div class="card-header">
        User List
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Organization</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@(user.Organization?.Name ?? "N/A")</td>
                        <td class="text-end">
                            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>