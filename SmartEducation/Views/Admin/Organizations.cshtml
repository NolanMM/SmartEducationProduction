@model IEnumerable<Organization>

@{
    ViewData["Title"] = "Manage Organizations";
}

<h1>Manage Organizations</h1>

<p>
    <a asp-action="CreateOrganization" class="btn btn-success">Create New Organization</a>
</p>

<div class="card">
    <div class="card-header">
        Organization List
    </div>
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Name)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>
                        <td class="text-end">
                            <a asp-action="ManageOrganizationUsers" asp-route-id="@item.Id" class="btn btn-sm btn-info">Manage Users</a>

                            <a asp-action="EditOrganization" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="DeleteOrganization" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>