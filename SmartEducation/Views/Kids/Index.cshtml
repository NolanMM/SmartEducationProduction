@model IEnumerable<Kid>

@{
    ViewData["Title"] = "My Kids";
}

<h1>My Kids</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Kid</a>
</p>

<div class="list-group">
    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            You have not added any kids yet. Click the button above to get started!
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@Html.DisplayFor(modelItem => item.Name)</h5>
                    <small>Birthday: @item.DateOfBirth.ToShortDateString()</small>
                </div>
                <div>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger ms-2">Delete</a>
                </div>
            </div>
        }
    }
</div>