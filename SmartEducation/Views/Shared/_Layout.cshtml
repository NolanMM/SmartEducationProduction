@using Microsoft.AspNetCore.Identity
@inject SignInManager<SmartEducation.Entities.User> SignInManager
@inject UserManager<SmartEducation.Entities.User> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartEducation</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartEducation.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @* @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin")) *@
                @* { *@
                @*     <a class="navbar-brand" asp-controller="Admin" asp-action="Index">SmartEducation</a> *@
                @* } *@
                @* else if (SignInManager.IsSignedIn(User) && User.IsInRole("OrganizationAdmin")) *@
                @* { *@
                @*     <a class="navbar-brand" asp-area="" asp-controller="Organization" asp-action="Index">SmartEducation</a> *@
                @* } *@
                @* else *@
                @* { *@
                @*     // Default "Home" link for regular users and non-logged-in visitors *@
                @*     <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SmartEducation</a> *@
                @* } *@
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">SmartEducation</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            @* @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin")) *@
                            @* { *@
                            @*     <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Home</a> *@
                            @* } *@
                            @* else if (SignInManager.IsSignedIn(User) && User.IsInRole("OrganizationAdmin")) *@
                            @* { *@
                            @*     <a class="nav-link text-dark" asp-controller="Organization" asp-action="Index">Home</a> *@
                            @* } *@
                            @* else *@
                            @* { *@
                            @*     // Default "Home" link for regular users and non-logged-in visitors *@
                            @*     <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a> *@
                            @* } *@
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">| Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">| Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Aboutus">| About Us</a>
                        </li>
                    </ul>

                    @inject SignInManager<User> _signInManager
                    <ul class="navbar-nav">
                        @if (_signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="ActivityRecommendation" asp-action="Index">| Lesson Plan Recommendation</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="ActivityRecommendation" asp-action="History">| Lesson Plan Recommendation History</a>
                            </li>

                            @* <li class="nav-item"> *@
                            @*     <a class="nav-link text-dark" asp-controller="Standard" asp-action="Index">| Standards</a> *@
                            @* </li> *@

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">| Admin Dashboard</a>
                                </li>
                            }
                            @if (User.IsInRole("OrganizationAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Organization" asp-action="Index">| Org Dashboard</a>
                                </li>
                            }
                            @if (User.IsInRole("User"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Kids" asp-action="Index">| My Kids</a>
                                </li>
                            }
                            <li class="nav-item">
                                <form class="form-inline" asp-controller="Account" asp-action="LogOut" method="post">
                                    <input type="submit" class="nav-link btn btn-link text-dark" value="| Logout @User.Identity.Name" />
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">| Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="LogIn">| Login</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - SmartEducation - 
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> -
            <a asp-area="" asp-controller="Home" asp-action="Aboutus">About Us</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
