@model ActivityRecommendation

@{
    // This is a partial view to render the details of a single activity.
    // It's used by RecommendationResult.cshtml to avoid code duplication.
}

<!-- Engineer Connection -->
<div class="mb-4">
    <h4 class="mb-3 border-bottom pb-2"><i class="bi bi-gear-wide-connected text-primary me-2"></i>Engineer Connection</h4>
    <p class="text-muted">@Model.EngineerConnection</p>
</div>

<!-- Introduction -->
<div class="mb-4">
    <h4 class="mb-3 border-bottom pb-2"><i class="bi bi-lightbulb text-primary me-2"></i>Introduction & Motivation</h4>
    <p>@Model.IntroductionMotivation</p>
</div>

<!-- Main Details in Columns -->
<div class="row mb-4">
    <div class="col-lg-6 mb-3 mb-lg-0">
        <h4 class="mb-3 border-bottom pb-2"><i class="bi bi-bullseye text-primary me-2"></i>Learning Objectives</h4>
        <ul class="list-group list-group-flush">
            @foreach (var objective in Model.LearningObjectives)
            {
                <li class="list-group-item d-flex align-items-start border-0 px-0">
                    <i class="bi bi-check-circle-fill text-success me-3 mt-1"></i>
                    <span>@objective</span>
                </li>
            }
        </ul>
    </div>
    <div class="col-lg-6">
        <h4 class="mb-3 border-bottom pb-2"><i class="bi bi-tools text-primary me-2"></i>Materials Needed</h4>
        <ul class="list-group list-group-flush">
            @foreach (var material in Model.MaterialLists)
            {
                <li class="list-group-item d-flex align-items-start border-0 px-0">
                    <i class="bi bi-box-seam text-info me-3 mt-1"></i>
                    <span>@material</span>
                </li>
            }
        </ul>
    </div>
</div>

<!-- Safety Issues -->
@if (!string.IsNullOrWhiteSpace(Model.SafetyIssues) && !Model.SafetyIssues.ToLower().Contains("none"))
{
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-3 fs-4"></i>
        <div>
            <h5 class="alert-heading mb-1">Safety First!</h5>
            @Model.SafetyIssues
        </div>
    </div>
}

<!-- Procedure -->
<div>
    <h4 class="mb-3 border-bottom pb-2"><i class="bi bi-list-ol text-primary me-2"></i>Step-by-Step Procedure</h4>
    @if (Model.Procedure != null && Model.Procedure.Any())
    {
        <ol class="list-group list-group-numbered">
            @foreach (var step in Model.Procedure)
            {
                <li class="list-group-item mb-2 border-start-0 border-end-0 ps-3">@step</li>
            }
        </ol>
    }
    else
    {
        <p class="text-muted">No procedure steps were provided.</p>
    }
</div>
