@model List<ActivityRecommendation>

@{
    ViewData["Title"] = "Your Recommendations";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4">Your Custom Recommendations</h1>
        <p class="lead">Here are the AI-generated activities based on your request.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            <h4>No recommendations were generated.</h4>
            <p>Please try refining your prompt for a better result.</p>
            <a asp-action="Index" class="btn btn-primary">Try Again</a>
        </div>
    }
    else
    {
        <div class="accordion" id="recommendationAccordion">
            @foreach (var (item, index) in Model.Select((item, index) => (item, index)))
            {
                <div class="accordion-item mb-3 border-0 shadow-sm rounded-lg">
                    <h2 class="accordion-header" id="heading-@index">
                        <button class="accordion-button @(index == 0 ? "" : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@index" aria-expanded="@(index == 0 ? "true" : "false")" aria-controls="collapse-@index">
                            <strong>@item.Summary</strong>
                        </button>
                    </h2>
                    <div id="collapse-@index" class="accordion-collapse collapse @(index == 0 ? "show" : "")" aria-labelledby="heading-@index" data-bs-parent="#recommendationAccordion">
                        <div class="accordion-body">
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <h5><i class="bi bi-cone-striped me-2"></i>Engineer Connection</h5>
                                    <p>@item.EngineerConnection</p>

                                    <h5><i class="bi bi-bullseye me-2"></i>Learning Objectives</h5>
                                    <ul class="list-unstyled">
                                        @foreach (var objective in item.LearningObjectives)
                                        {
                                            <li><i class="bi bi-check-lg text-success me-2"></i>@objective</li>
                                        }
                                    </ul>

                                    <h5><i class="bi bi-box-seam me-2"></i>Materials Needed</h5>
                                    <ul class="list-unstyled">
                                        @foreach (var material in item.MaterialLists)
                                        {
                                            <li><i class="bi bi-box text-info me-2"></i>@material</li>
                                        }
                                    </ul>
                                </div>
                                <div class="col-md-6 mb-4">
                                    <h5><i class="bi bi-lightbulb me-2"></i>Introduction & Motivation</h5>
                                    <p>@item.IntroductionMotivation</p>

                                    <h5><i class="bi bi-exclamation-triangle me-2"></i>Safety Issues</h5>
                                    <p class="text-danger">@item.SafetyIssues</p>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <h5><i class="bi bi-list-ol me-2"></i>Procedure</h5>
                            <ol>
                                @foreach (var step in item.Procedure)
                                {
                                    <li class="mb-2">@step</li>
                                }
                            </ol>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-action="Index" class="btn btn-secondary me-2">Make Another Request</a>
            <a asp-action="History" class="btn btn-info">View My History</a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
}
