@model List<SmartEducation.Entities.ActivityRecommendation>

@{
    var isLessonPlan = Model != null && Model.Count > 1;
    ViewData["Title"] = isLessonPlan ? "Your Lesson Plan" : "Your Activity Recommendation";
}

<style>
    .lesson-plan-card {
        transition: box-shadow .3s ease-in-out;
    }

        .lesson-plan-card:hover {
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .accordion-button:not(.collapsed) {
        color: #fff;
        background-color: #212529; /* A dark color for the active header */
    }

        .accordion-button:not(.collapsed)::after {
            filter: brightness(0) invert(1);
        }
</style>

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4">@ViewData["Title"]</h1>
        <p class="lead text-muted">Here is the AI-generated content based on your request.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            <h4 class="alert-heading">No Recommendations Found</h4>
            <p>We couldn't generate any activities based on your prompt. This can sometimes happen with very specific or unusual requests.</p>
            <hr>
            <a asp-action="Index" class="btn btn-primary">Please Try Again</a>
        </div>
    }
    else if (isLessonPlan)
    {
        <h2 class="h4 mb-4">Lesson Plan Activities</h2>
        <div class="accordion" id="recommendationAccordion">
            @foreach (var (item, index) in Model.Select((item, index) => (item, index)))
            {
                <div class="accordion-item mb-3 border-0 shadow-sm rounded-3 lesson-plan-card">
                    <h2 class="accordion-header" id="heading-@index">
                        <button class="accordion-button @(index == 0 ? "" : "collapsed") fw-bold rounded-top-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@index" aria-expanded="@(index == 0 ? "true" : "false")" aria-controls="collapse-@index">
                            Activity @(index + 1): @item.NameOfActivity
                        </button>
                    </h2>
                    <div id="collapse-@index" class="accordion-collapse collapse @(index == 0 ? "show" : "")" aria-labelledby="heading-@index" data-bs-parent="#recommendationAccordion">
                        <div class="accordion-body p-4">
                            @await Html.PartialAsync("_ActivityDetails", item)
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        var singleActivity = Model.First();
        <div class="card shadow-sm border-0 rounded-3 lesson-plan-card">
            <div class="card-header bg-light py-3 border-0">
                <h2 class="h4 mb-0">@singleActivity.Summary</h2>
            </div>
            <div class="card-body p-4 p-md-5">
                @await Html.PartialAsync("_ActivityDetails", singleActivity)
            </div>
        </div>
    }

    <div class="text-center mt-5">
        <a asp-action="Index" class="btn btn-secondary me-2"><i class="bi bi-arrow-left me-1"></i> New Request</a>
        <a asp-action="History" class="btn btn-outline-dark"><i class="bi bi-clock-history me-1"></i> View My History</a>
    </div>
</div>
