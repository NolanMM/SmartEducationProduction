@{
    ViewData["Title"] = "Lesson Plan Recommendation";
}

<div class="bg-body-tertiary">
    <div class="container d-flex flex-column justify-content-center min-vh-90 py-4">
        <div class="row justify-content-center">
            <div class="col-xl-7 col-lg-9">
                <div class="card shadow-lg border-0 rounded-4 fade-in-card">
                    <div class="card-header bg-primary  bg-black text-white text-center py-4 border-0">
                        <h1 class="fw-light mb-0"><b>Lesson Plan Generator</b></h1>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <p class="lead text-center text-body-secondary mb-4">
                            Describe the educational activity you need. Provide details like <b>subject</b>, <b>age group</b>, and desired <b>learning outcomes</b> for the best results.
                            Provide details like <b>subject</b>, <b>age group</b>, and desired <b>learning outcomes</b> for the best results.
                        </p>

                        <div class="text-center mb-4">
                            <small class="text-muted">For example: "A 20-minute science activity for 8-year-olds about gravity using household items."</small>
                        </div>

                        <form id="recommendationForm" asp-controller="ActivityRecommendation" asp-action="GetRecommendation" method="post">
                            @Html.AntiForgeryToken()
                            <ul id="chatLog" class="list-group list-group-flush mb-3" style="max-height: 420px; overflow-y: auto;">
                            </ul>

                            <div class="form-floating mb-3">
                                <textarea id="userPrompt" name="userPrompt" class="form-control" placeholder="Enter your prompt here" rows="8" style="height:12rem; padding-top:40px" required></textarea>
                                <label for="userPrompt">Your Detailed Prompt</label>
                            </div>

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="d-grid mt-4 ">
                                <button id="submitButton" type="submit" class="btn btn-primary  bg-black btn-lg fw-semibold py-3" style="border-color:black">
                                    <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                                    <span class="button-text ">Generate Recommendation</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="card-footer text-center bg-white py-3 border-0">
                        <a asp-action="History" asp-controller="ActivityRecommendation" class="link-secondary text-decoration-none"><i class="bi bi-clock-history me-1"></i> View My Recommendation History</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const recommendationForm = document.getElementById('recommendationForm');
        const submitButton = document.getElementById('submitButton');
        const userPromptTextarea = document.getElementById('userPrompt');
        const chatLog = document.getElementById('chatLog');
        const spinner = submitButton.querySelector('.spinner-border');
        const buttonText = submitButton.querySelector('.button-text');
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        const promptStorageKey = 'userFullActivityPrompt';
        let fullPrompt = '';

        // Change initial button text for chat interface
        document.addEventListener('DOMContentLoaded', () => {
            buttonText.textContent = 'Send';
            document.querySelector('label[for="userPrompt"]').textContent = 'Describe your activity needs...';

            const savedPrompt = localStorage.getItem(promptStorageKey);
            if (savedPrompt) {
                //fullPrompt = savedPrompt;
                //console.log('Restored prompt from previous session.');
                localStorage.removeItem(promptStorageKey);
                console.log('Remove prompt from previous session.');
            }
        });

        // Handle submission via button click or enter key
        recommendationForm.addEventListener('submit', function (e) {
            e.preventDefault();
            sendMessage();
        });

        function appendMessage(role, text) {
            const li = document.createElement('li');
            li.className = `list-group-item border-0 d-flex my-1 ${role === 'user' ? 'justify-content-end' : 'justify-content-start'}`;

            const messageDiv = document.createElement('div');
            messageDiv.className = `p-3 rounded-3 shadow-sm ${role === 'user' ? 'bg-primary text-white' : 'bg-light text-dark'}`;
            messageDiv.style.maxWidth = '80%';
            messageDiv.style.whiteSpace = 'pre-wrap'; // Preserve newlines
            messageDiv.textContent = text;

            li.appendChild(messageDiv);
            chatLog.appendChild(li);
            chatLog.scrollTop = chatLog.scrollHeight; // Auto-scroll to bottom
        }

        async function sendMessage() {
            const promptText = userPromptTextarea.value.trim();
            if (promptText === '') {
                return;
            }

            appendMessage('user', promptText);

            if (fullPrompt.length > 0) {
                fullPrompt += ' ' + promptText;
            } else {
                fullPrompt = promptText;
            }

            localStorage.setItem(promptStorageKey, fullPrompt);

            // Keep track of the prompt that gets validated
            const lastUserPrompt = promptText; 
            userPromptTextarea.value = ''; // Clear input

            // Show loading state
            submitButton.disabled = true;
            spinner.classList.remove('d-none');
            buttonText.textContent = 'Thinking...';

            try {
                const response = await fetch('/ActivityRecommendation/SendAsyncChat', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ prompt: fullPrompt })
                });

                if (!response.ok) {
                    appendMessage('server', 'An error occurred while communicating with the server. Please try again.');
                    // Re-enable button on error
                    submitButton.disabled = false;
                    spinner.classList.add('d-none');
                    buttonText.textContent = 'Send';
                    return;
                }

                const data = await response.json();
                const serverMessage = data.messages.find(m => m.role === 'server');

                if (serverMessage) {
                    appendMessage('server', serverMessage.text);
                }

                if (data.isComplete) {
                    buttonText.textContent = 'Generating...';
                    // Put the successful prompt back into the textarea for submission
                    document.getElementById('userPrompt').value = fullPrompt;
                    // The form can now be submitted to the GetRecommendation action
                    recommendationForm.submit();
                    localStorage.removeItem(promptStorageKey);
                    fullPrompt = '';
                } else {
                    // Re-enable for the next message
                    submitButton.disabled = false;
                    spinner.classList.add('d-none');
                    buttonText.textContent = 'Send';
                    userPromptTextarea.focus();
                }

            } catch (error) {
                appendMessage('server', 'A network error occurred. Please check your connection and try again.');
                submitButton.disabled = false;
                spinner.classList.add('d-none');
                buttonText.textContent = 'Send';
            }
        }
    </script>
}