@model IEnumerable<ActivityRecommendation>

@{
    ViewData["Title"] = "Recommendation History";
}

<div class="container my-5">
    <div class="text-center mb-5">
         <h1 class="display-4">Recommendation History</h1>
         <p class="lead">Here are all the recommendations you've generated in the past.</p>
     </div>
    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="text-center">
            <p>You have not generated any recommendations yet.</p>
            <a asp-action="Index" class="btn btn-primary bg-black" style="border-color:black; padding: 20px">Get your first recommendation!</a>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var item in Model)
            {
                <a asp-action="Details" asp-route-id="@item.Id" class="list-group-item list-group-item-action flex-column align-items-start mb-2 border-0 rounded-lg">
                    <h5 class="mb-1 text-muted pb-2"><em>@item.NameOfActivity</em></h5>
                    <div class="row g-0 align-items-start mb-2 pb-2">
                        <div class="col">
                            <p class="mb-0">@item.Summary</p>
                        </div>
                        <div class="col-auto ps-3">
                            <small class="text-muted">@item.CreatedAt.ToShortDateString()</small>
                        </div>
                    </div>
                    <span/>
                    <div class="row g-0 align-items-start mb-2">
                        <div class="col">
                            <p><b>Number of tokens:</b> @item.TotalTokens</p>
                        </div>
                        @* <div class="col-auto ps-3"> *@
                        @*     <p><b>Education Standard:</b> @item.EducationStandards[0]</p> *@
                        @* </div> *@
                    </div>
                </a>
                <br />
            }
        </div>
    }
</div>
